#!/bin/bash
# gsget <branch>: fetch a remote branch and check it out in a usable state:
# fresh origin refs, up to date with its origin counterpart, with a gs summary.
# Uses a safe fast-forward only — never rewrites local commits.

set -u -o pipefail

if [ $# -ne 1 ]; then
  echo "usage: gsget <branch>" >&2
  exit 1
fi
branch=$1

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "gsget: not in a git repository" >&2
  exit 1
fi

echo "fetching origin…"
if ! git fetch origin; then
  echo "gsget: fetch failed" >&2
  exit 1
fi

if ! out=$(git switch "$branch" 2>&1); then
  case $out in
    *"used by worktree"*)
      echo "gsget: '$branch' is checked out in another worktree:" >&2
      git worktree list 2>/dev/null | grep "\[$branch\]" >&2
      echo "use that tree, or free the branch there first" >&2
      ;;
    *)
      printf '%s\n' "$out" >&2
      ;;
  esac
  exit 1
fi
printf '%s\n' "$out"

# fast-forward onto origin's tip if the remote branch exists
if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
  if ! git merge --ff-only "origin/$branch" >/dev/null 2>&1; then
    echo "note: local '$branch' has diverged from origin — not fast-forwarded; rebase or reset manually" >&2
  fi
fi

if [ -z "$(git config --get "branch.$branch.wgh-parent" 2>/dev/null)" ]; then
  echo "hint: not in a dt stack — run 'dt track' so dt sync maintains this branch"
fi
echo

exec "${GS:-$(dirname "$0")/gs}"
